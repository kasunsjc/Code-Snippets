# Example variable values for the AKS Argo CD extension demo.
# Copy this file to terraform.tfvars and adjust the values for your environment:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored so your real values (and cert paths) stay local.

# --- Required ---------------------------------------------------------------

# Existing public Azure DNS zone used for the Argo CD ingress.
dns_zone_name           = "example.com"
dns_zone_resource_group = "rg-dns-zones"

# FQDN exposed for the Argo CD server (must be a record under dns_zone_name).
argocd_hostname = "argocd.example.com"

# Path to a .pfx certificate covering argocd_hostname (relative to terraform/).
# Imported into Key Vault and served by the App Routing NGINX ingress.
certificate_pfx_path = "./star_example_com.pfx"

# Uncomment only if the .pfx file is password protected.
# certificate_pfx_password = "secret"

# --- Optional (defaults shown) ----------------------------------------------

# project                   = "argocd"
# environment               = "demo"
# location                  = "northeurope"
# kubernetes_version        = "1.34"
# node_count                = 2
# node_vm_size              = "Standard_D4ds_v5"
# user_node_pool_name       = "user"
# user_node_pool_vm_size    = "Standard_D4ds_v5"
# user_node_pool_node_count = 2

# Additional reply URLs to register on the Entra ID app (e.g. for argocd CLI SSO).
# extra_redirect_uris = ["http://localhost:8085/auth/callback"]
