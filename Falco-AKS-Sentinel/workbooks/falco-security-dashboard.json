            "label": "Priority Filter",
            "type": 2,
            "isRequired": false,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "FalcoLogs_CL\n| where TimeGenerated {TimeRange}\n| where isnotempty(priority_s)\n| distinct priority_s\n| sort by priority_s asc",
            "crossComponentResources": [
              "{Workspace}"
            ],
            "value": [
              "value::all"
            ],
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "showDefault": false
            },
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "d8d9f9d4-4f4f-5d6f-0f6f-9d6f6f6f6f6f",
            "version": "KqlParameterItem/1.0",
            "name": "Namespace",
            "label": "Namespace Filter",
            "type": 2,
            "isRequired": false,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "FalcoLogs_CL\n| where TimeGenerated {TimeRange}\n| where isnotempty(output_fields_k8s_ns_name_s)\n| distinct output_fields_k8s_ns_name_s\n| sort by output_fields_k8s_ns_name_s asc",
