# Copy to terraform.tfvars and adjust as needed.
project                      = "cpmetrics"
environment                  = "demo"
location                     = "eastus2"
node_vm_size                 = "Standard_D4s_v5"
node_count                   = 2
enable_control_plane_metrics = true
grafana_major_version        = 12

# Usually passed by deploy.sh from 'az ad signed-in-user show --query id -o tsv'
# user_object_id = "00000000-0000-0000-0000-000000000000"

tags = {
  owner = "your-name"
}
