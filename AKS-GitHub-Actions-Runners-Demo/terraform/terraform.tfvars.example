project     = "gha-runners"
environment = "dev"
location    = "northeurope"

# Optional (recommended): restrict the AKS API to your workstation/VPN egress IPs.
# Leave empty for an unrestricted demo; Entra ID + Azure RBAC still guard access.
# api_server_authorized_ip_ranges = ["<your-public-ip>/32"]
api_server_authorized_ip_ranges = []

cache_share_quota_gib = 100
