location = "northeurope"
project = "harborprod"
environment = "demo"
dns_zone_name = "example.com"
dns_zone_resource_group = "rg-dns-shared"
harbor_subdomain = "harbor"
acme_email = "you@example.com"
user_object_id = ""
enable_oidc_auth = true
harbor_oidc_app_display_name = "harbor-oidc-sso"
harbor_admin_group_member_upns = []

# Jumpbox auth: leave both blank to auto-generate a password (retrieve it with
# `terraform output -raw jumpbox_admin_password`). SSH key auth is more secure -
# generate one with `ssh-keygen -t ed25519 -f ./harbor-jumpbox-key -N ""` and
# set jumpbox_ssh_public_key to use it instead (or in addition).
jumpbox_ssh_public_key = ""
jumpbox_admin_password = ""
jumpbox_admin_username = "azureuser"
jumpbox_vm_size = "Standard_B2s"
