# =======================================================
# AKS KEDA Demo — Sample Apps
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =======================================================

# -------------------------------------------------------
# Storage Queue Consumer (Scenario 01)
# -------------------------------------------------------
# Retrieve with:
#   az storage account show-connection-string \
#     --name <storage-account-name> \
#     --resource-group rg-aks-keda-demo \
#     --query connectionString -o tsv
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net

# Name of the queue to consume from
QUEUE_NAME=keda-demo-queue

# Seconds between polls when the queue is empty
POLL_INTERVAL_SECONDS=5

# Max messages to dequeue per poll (1-32)
MAX_MESSAGES_PER_POLL=32

# -------------------------------------------------------
# Event Hub Consumer (Scenario 05)
# -------------------------------------------------------
# Retrieve the namespace connection string with:
#   az eventhubs namespace authorization-rule keys list \
#     --resource-group rg-aks-keda-demo \
#     --namespace-name <namespace> \
#     --name RootManageSharedAccessKey \
#     --query primaryConnectionString -o tsv
AZURE_EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>

# Name of the Event Hub (topic) inside the namespace
EVENTHUB_NAME=keda-demo-hub

# Consumer group to read from ($Default is always available)
CONSUMER_GROUP=$Default

# Where to start when no checkpoint exists.
# Use "@latest" to receive only new events (good for demos).
# Use "-1" to replay from the beginning of the retention window.
STARTING_POSITION=@latest

# -------------------------------------------------------
# Checkpoint Store (optional — required for KEDA Scenario 05)
# -------------------------------------------------------
# Providing this enables Azure Blob Storage checkpointing so that:
#   1. Consumer position survives restarts
#   2. KEDA can measure per-consumer-group lag and scale accordingly
#
# You can reuse the same storage account as the queue consumer.
# The container will be created automatically if it does not exist.
#
# AZURE_STORAGE_CHECKPOINT_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
# CHECKPOINT_CONTAINER_NAME=eventhub-checkpoints

# -------------------------------------------------------
# Producer Configuration (both scenarios)
# -------------------------------------------------------
# Interval in seconds between message/event batches
MESSAGE_INTERVAL_SECONDS=2
EVENT_INTERVAL_SECONDS=2

# Number of messages/events to send per batch
# Increase to simulate higher load (e.g., 10 messages per interval)
BATCH_SIZE=1

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
# Log level for all apps (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
