{
  "properties": {
    "displayName": "[Custom] Kubernetes containers should not use the latest image tag",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "description": "Custom OPA policy preventing mutable latest image tags.",
    "metadata": {
      "version": "1.0.0",
      "category": "Kubernetes"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "audit allows a non-compliant resource to be created and reports it; deny blocks it; disabled turns it off."
        },
        "allowedValues": [
          "audit",
          "deny",
          "disabled"
        ],
        "defaultValue": "audit"
      },
      "namespaces": {
        "type": "Array",
        "metadata": {
          "displayName": "Namespaces",
          "description": "Namespaces included in evaluation; empty means all."
        },
        "defaultValue": []
      },
      "excludedNamespaces": {
        "type": "Array",
        "metadata": {
          "displayName": "Namespace exclusions",
          "description": "Namespaces excluded from evaluation."
        },
        "defaultValue": [
          "kube-system",
          "gatekeeper-system",
          "azure-arc",
          "azure-policy"
        ]
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "in": [
          "Microsoft.ContainerService/managedClusters",
          "Microsoft.Kubernetes/connectedClusters"
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "templateInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          },
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ],
          "namespaces": "[parameters('namespaces')]",
          "excludedNamespaces": "[parameters('excludedNamespaces')]",
          "values": {}
        }
      }
    }
  }
}
