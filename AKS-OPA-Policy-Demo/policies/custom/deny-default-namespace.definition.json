{
  "properties": {
    "displayName": "[Custom] Kubernetes cluster should not use the default namespace",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "description": "Custom OPA/Rego-backed Azure Policy definition. Unlike the other policies in this demo, this one is NOT based on a public Gatekeeper library template - it embeds a small, self-authored Rego ConstraintTemplate directly via templateInfo.sourceType=Base64Encoded, showing how to ship your own OPA policy logic with no external dependency.",
    "metadata": {
      "version": "1.0.0",
      "category": "Kubernetes"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "'audit' allows a non-compliant resource to be created but flags it as non-compliant. 'deny' blocks the non-compliant resource from being created. 'disabled' turns off the policy."
        },
        "allowedValues": [
          "audit",
          "deny",
          "disabled"
        ],
        "defaultValue": "audit"
      },
      "namespaces": {
        "type": "Array",
        "metadata": {
          "displayName": "Namespaces",
          "description": "List of Kubernetes namespaces to include in policy evaluation. An empty list means all namespaces not explicitly excluded."
        },
        "defaultValue": []
      },
      "excludedNamespaces": {
        "type": "Array",
        "metadata": {
          "displayName": "Namespace exclusions",
          "description": "List of Kubernetes namespaces to exclude from policy evaluation. 'default' is intentionally NOT in this list, since it is the namespace this policy targets."
        },
        "defaultValue": [
          "kube-system",
          "gatekeeper-system",
          "azure-arc",
          "azure-policy"
        ]
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "in": [
          "Microsoft.Kubernetes.Data"
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "templateInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          },
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ],
          "namespaces": "[parameters('namespaces')]",
          "excludedNamespaces": "[parameters('excludedNamespaces')]"
        }
      }
    }
  }
}
